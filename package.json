{
  "name": "anomaly-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "External control dashboard for the AnomalyInjector in-game control server (pure localhost client).",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:tauri": "npm run build && node -e \"require('fs').rmSync('dist/config.json',{force:true})\"",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@tauri-apps/api": "2.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
